# Copy to a local untracked file if you prefer environment variables.
# Do not put real secrets in this file. FalkorDB credentials already belong in
# backend/src/main/resources/application-local.properties, which is gitignored.

POSTGRES_URL=jdbc:postgresql://localhost:5432/changegraph
POSTGRES_USER=changegraph
POSTGRES_PASSWORD=change-me

# Leave the existing FalkorDB host and port in application.properties.
# Set credentials only in application-local.properties or these variables.
# Docker Compose overrides the host and port with its own FalkorDB service.
FALKORDB_USERNAME=
FALKORDB_PASSWORD=

# Docker Compose publishes the UI and API together on this origin.
WEB_PORT=8080
PUBLIC_ORIGIN=http://localhost:8080

# Set to true only when you approve applying Flyway migrations.
FLYWAY_ENABLED=false

FRONTEND_ORIGIN=http://localhost:5173
SESSION_COOKIE_SECURE=false

# Optional personal access token. Prefer application-local.properties over this file.
# A classic personal access token or a fine-grained token with public repository access is enough.
# The developer agent also uses this token to open a fix pull request. It needs contents write and
# pull request write on that public repository (classic scope: public_repo). It never pushes to the
# default branch, merges a pull request, or deploys.
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_CONNECT_TIMEOUT_MS=5000
GITHUB_REQUEST_TIMEOUT_MS=15000
GITHUB_MAX_RETRIES=1

# Shared secret for the GitHub webhook. Leave empty to reject webhook deliveries.
# On the public repository, add a webhook for push and pull request events:
# payload URL ${PUBLIC_ORIGIN}/api/github/webhooks, content type application/json, this secret.
GITHUB_WEBHOOK_SECRET=

# Optional OpenAI-compatible planner. Empty key keeps analysis on the deterministic graph fallback.
CHANGEGRAPH_LLM_BASE_URL=https://api.openai.com/v1
CHANGEGRAPH_LLM_API_KEY=
CHANGEGRAPH_LLM_MODEL=gpt-4o-mini
CHANGEGRAPH_LLM_TIMEOUT_MS=60000
CHANGEGRAPH_LLM_MAX_OUTPUT_TOKENS=2000

PASSWORD_MIN_LENGTH=10
AUTH_MAX_ATTEMPTS=10
AUTH_WINDOW_SECONDS=60
