# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Local FalkorDB module binary (scripts/install-falkordb-homebrew.sh)
local/falkordb/

# Local secrets. Real passwords and tokens stay in these files, never in application.properties.
backend/src/main/resources/application-local.properties
**/application-local.properties
**/*-local.properties

# Environment files
.env
.env.*
!.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Keys and credential files
*.pem
*.p12
*.jks
*.key
credentials.json
credentials*.json
**/*secret*
**/*credentials*

# Build outputs
backend/target/
frontend/dist/
frontend/node_modules/

# IDE and OS
.DS_Store
backend/.idea/
